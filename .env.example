# filename: .env.example
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:3000
AI_MODE=disabled
ALLOW_DEMO_AI=0
# Existing downloaded SDK config; server only, never NEXT_PUBLIC.
ONYX_CONFIG_PATH=/absolute/path/to/onyx-database.json
ONYX_SEARCH_MODE=lexical
# Only needed for live agents. See README's scoped agent setup.
ONYX_AI_BINDINGS_PATH=/absolute/path/to/ignored/config/ai-bindings.json
# Your application Firebase project, separate from Onyx platform authentication.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
# Prefer Application Default Credentials. Optional base64 service account JSON:
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Local Auth Emulator only; project id must start with demo-.
FIREBASE_AUTH_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=
# npm run seed uses an existing verified application user.
SEED_USER_UID=
