{
  "name": "ai-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test && npm run build",
    "schema:validate": "node --import tsx scripts/schema.ts validate",
    "schema:diff": "node --import tsx scripts/schema.ts diff",
    "schema:publish": "node --import tsx scripts/schema.ts publish",
    "schema:generate": "onyx-gen --source file --schema api/onyx.schema.json --out lib/onyx/generated.ts --timestamps string --optional none",
    "seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "test:preview": "node tests/preview.mjs",
    "template:init": "node scripts/init-template.mjs",
    "template:smoke": "node scripts/smoke-template.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.158",
    "@hookform/resolvers": "5.4.0",
    "@onyx.dev/onyx-database": "2.8.4",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tooltip": "1.2.12",
    "@streamdown/code": "2.0.0",
    "ai": "7.0.154",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "1.24.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.81.0",
    "server-only": "0.0.1",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "firebase-tools": "15.34.1",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "postcss": "8.5.31"
  }
}
